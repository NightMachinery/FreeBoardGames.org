{
  "name": "fbg-runner",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "codegen": "node cli/codegen/cli.js",
    "test": "node cli/test/test.js",
    "lint": "node cli/lint/lint.js",
    "fix": "node cli/fix/fix.js",
    "dev": "node cli/dev/cli.js",
    "ci": "pnpm run test && ./docker-build.sh -db && ./misc/test_minikube",
    "build": "pnpm --dir web run build && pnpm --dir web run build:server",
    "storybook": "pnpm --dir web run storybook",
    "dev:internal": "run-p web:dev backend:dev",
    "backend:dev": "pnpm --dir fbg-server run start",
    "ci:web": "pnpm --dir web run ci",
    "install:backend": "pnpm install --filter ./fbg-server...",
    "install:web": "pnpm install --filter ./web...",
    "install:e2e": "pnpm install --filter ./misc/e2e...",
    "test:backend": "pnpm --dir fbg-server run test",
    "test:web": "pnpm --dir web run test",
    "web:dev": "pnpm --dir web run dev:internal",
    "build:selfhost": "pnpm --dir web run build:next && pnpm --dir web run build:server"
  },
  "dependencies": {
    "npm-run-all": "^4.1.5"
  },
  "devDependencies": {
    "chalk": "^5.3.0",
    "shelljs": "^0.8.5"
  },
  "packageManager": "pnpm@10.33.2",
  "pnpm": {
    "packageExtensions": {
      "apollo-codegen-core@*": {
        "dependencies": {
          "graphql": "15.10.2"
        }
      },
      "apollo-codegen-typescript@*": {
        "dependencies": {
          "graphql": "15.10.2"
        }
      }
    },
    "overrides": {
      "@types/recompose>@types/react": "17.0.44",
      "@types/react": "17.0.44",
      "@apollo/react-hooks>@apollo/client": "3.14.1"
    }
  }
}
